# Public HTTPS address of the deployed GucLogistics Spring Boot API.
VITE_GUC_API_URL=https://api.example.com
VITE_USE_MOCK_DATA=false
# Demo credentials are accepted only in non-production Vite modes.
VITE_API_TIMEOUT_MS=15000

# Backend (copy to .env; never commit real secrets)
POSTGRES_DB=guclogistics
DB_URL=jdbc:postgresql://localhost:5432/guclogistics
DB_USER=guc
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
REGISTER_RATE_LIMIT_PER_HOUR=5
JWT_REFRESH_TOKEN_DAYS=7
ENCRYPTION_KEY=
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://app.example.com,https://www.example.com
GUC_STORAGE_PATH=./data/uploads
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Match/offer email notifications. Enable only with a working SMTP account.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
