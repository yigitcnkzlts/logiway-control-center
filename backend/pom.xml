<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.guclogistics</groupId>
    <artifactId>guc-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>GucLogistics Parent</name>
    <description>Enterprise logistics platform — modular monolith</description>

    <modules>
        <module>guc-shared</module>
        <module>guc-identity-access</module>
        <module>guc-users</module>
        <module>guc-companies</module>
        <module>guc-drivers</module>
        <module>guc-vehicles</module>
        <module>guc-verification</module>
        <module>guc-loads</module>
        <module>guc-offers</module>
        <module>guc-matching</module>
        <module>guc-notifications</module>
        <module>guc-audit</module>
        <module>guc-api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.38</lombok.version>
        <mapstruct.version>1.6.2</mapstruct.version>
        <springdoc.version>2.6.0</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <testcontainers.version>1.20.3</testcontainers.version>
        <tika.version>2.9.2</tika.version>
        <jacoco.version>0.8.13</jacoco.version>
        <coverage.minimum>0.80</coverage.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-identity-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-users</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-companies</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-drivers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-vehicles</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-verification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-loads</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-offers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-matching</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-notifications</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guclogistics</groupId>
                <artifactId>guc-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>${tika.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>0.2.0</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/domain/event/**</exclude>
                        <exclude>**/shared/events/**</exclude>
                        <exclude>**/GucLogisticsApplication.class</exclude>
                        <exclude>**/config/OpenApiConfig.class</exclude>
                        <exclude>**/config/CorsConfig.class</exclude>
                        <!-- JPA entity lifecycle boilerplate covered via integration tests -->
                        <exclude>**/infrastructure/persistence/*Entity.class</exclude>
                        <!-- Wiring-only Spring Security filter chain; exercised by AuthFlowIntegrationTest -->
                        <exclude>**/infrastructure/security/SecurityConfig.class</exclude>
                        <!-- Thin REST adapters; business rules covered in application service unit tests -->
                        <exclude>**/api/*Controller.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
